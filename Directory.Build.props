<Project>
  <PropertyGroup>
    <Version>1.4.2</Version>
    <AssemblyName>scenetake</AssemblyName>
    <PackageId>scenetake</PackageId>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>scenetake</ToolCommandName>
    <Authors>guitarrapc</Authors>
    <Description>Run a YAML scenario and record terminal output as asciinema v3 .cast and animated .svg without installing asciinema</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/guitarrapc/scenetake</PackageProjectUrl>
    <RepositoryUrl>https://github.com/guitarrapc/scenetake.git</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
