{
  "name": "scenetake",
  "version": "1.3.0",
  "description": "Run a YAML scenario and record terminal output as asciinema v3 .cast and animated .svg without installing asciinema",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guitarrapc/scenetake.git"
  },
  "homepage": "https://github.com/guitarrapc/scenetake#readme",
  "bugs": {
    "url": "https://github.com/guitarrapc/scenetake/issues"
  },
  "bin": {
    "scenetake": "bin/scenetake.js"
  },
  "files": [
    "bin",
    "README.md"
  ],
  "optionalDependencies": {
    "@scenetake/darwin-arm64": "1.3.0",
    "@scenetake/darwin-x64": "1.3.0",
    "@scenetake/linux-arm64": "1.3.0",
    "@scenetake/linux-x64": "1.3.0",
    "@scenetake/win32-arm64": "1.3.0",
    "@scenetake/win32-x64": "1.3.0"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "engines": {
    "node": ">=18"
  },
  "preferGlobal": true
}
