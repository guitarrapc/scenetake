<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <!--
    The browser playground (.github/docs/spec_playground.md). It compiles the same source files as the CLI
    (scenetake.cs includes them with #:include), without the code that starts processes, and replays the
    outputs files of the samples instead of running commands.

    Local run (from the repository root):
      dotnet publish playground/Scenetake.Playground.csproj -c Release -p:PlaygroundSoftFingerprint=true -o artifacts/playground
      node playground/serve.mjs artifacts/playground/wwwroot
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- The repository's Directory.Build.props is for the CLI package; the version stays, the package settings do not. -->
    <AssemblyName>Scenetake.Playground</AssemblyName>
    <RootNamespace>Scenetake.Playground</RootNamespace>
    <PackAsTool>false</PackAsTool>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <InvariantTimezone>true</InvariantTimezone>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <PropertyGroup>
    <!-- A large PTY sample renders an SVG of a few MB; start with room for it. -->
    <EmccInitialHeapSize>67108864</EmccInitialHeapSize>
    <EmccMaximumHeapSize>1073741824</EmccMaximumHeapSize>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <RunAOTCompilation>true</RunAOTCompilation>
    <WasmEnableWebcil>true</WasmEnableWebcil>
  </PropertyGroup>

  <!--
    GitHub Pages has no import map rewriting: -p:PlaygroundSoftFingerprint=true emits both fingerprinted and plain
    file names, so href="style.css" and import './_framework/dotnet.js' resolve as they are.
  -->
  <PropertyGroup Condition="'$(PlaygroundSoftFingerprint)' == 'true'">
    <PlaygroundFingerprintSuffix>?</PlaygroundFingerprintSuffix>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PlaygroundSoftFingerprint)' != 'true'">
    <PlaygroundFingerprintSuffix>!</PlaygroundFingerprintSuffix>
  </PropertyGroup>

  <ItemGroup>
    <StaticWebAssetFingerprintPattern Include="JS" Pattern="*.js" Expression="#[.{fingerprint}]$(PlaygroundFingerprintSuffix)" />
    <StaticWebAssetFingerprintPattern Include="MJS" Pattern="*.mjs" Expression="#[.{fingerprint}]$(PlaygroundFingerprintSuffix)" />
    <StaticWebAssetFingerprintPattern Include="CSS" Pattern="*.css" Expression="#[.{fingerprint}]$(PlaygroundFingerprintSuffix)" />
  </ItemGroup>

  <!-- The CLI's shared source. scenetake.cs includes the same files. -->
  <ItemGroup>
    <Compile Include="../Terminal.cs" Link="Shared/Terminal.cs" />
    <Compile Include="../CastTimingPipeline.cs" Link="Shared/CastTimingPipeline.cs" />
    <Compile Include="../CastReader.cs" Link="Shared/CastReader.cs" />
    <Compile Include="../Svg.cs" Link="Shared/Svg.cs" />
    <Compile Include="../JsonEscape.cs" Link="Shared/JsonEscape.cs" />
    <Compile Include="../PtyLeadingInitFilter.cs" Link="Shared/PtyLeadingInitFilter.cs" />
    <Compile Include="../ScenarioKeys.cs" Link="Shared/ScenarioKeys.cs" />
    <Compile Include="../Scenario.cs" Link="Shared/Scenario.cs" />
    <Compile Include="../Highlight.cs" Link="Shared/Highlight.cs" />
    <Compile Include="../CastComposer.cs" Link="Shared/CastComposer.cs" />
    <Compile Include="../StepChunks.cs" Link="Shared/StepChunks.cs" />
    <Compile Include="../StepOutputs.cs" Link="Shared/StepOutputs.cs" />
    <Compile Include="../PlaygroundRender.cs" Link="Shared/PlaygroundRender.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="VYaml" Version="1.6.1" />
  </ItemGroup>

  <!--
    The samples the playground offers: each <name>.yaml with a <name>.outputs.json, with its cast for the Cast tab,
    from samples/ and from samples/showcase/ (recorded in a container by samples/showcase/record.sh). They are copied
    into one folder next to the page, with samples/index.json listing their names.
  -->
  <ItemGroup>
    <PlaygroundOutputs Include="../samples/*.outputs.json;../samples/showcase/*.outputs.json" />
    <PlaygroundCast Include="../samples/*.cast;../samples/showcase/*.cast" />
  </ItemGroup>

  <Target Name="_CopyPlaygroundSamples" AfterTargets="Publish">
    <ItemGroup>
      <_PlaygroundSampleName Include="@(PlaygroundOutputs->'%(Filename)'->Replace('.outputs', ''))" />
      <_PlaygroundSampleYaml Include="@(PlaygroundOutputs->'%(RelativeDir)%(Filename).yaml'->Replace('.outputs.yaml', '.yaml'))" />
    </ItemGroup>
    <Error Condition="'@(_PlaygroundSampleYaml)' != '' and !Exists('%(_PlaygroundSampleYaml.Identity)')" Text="An outputs file has no scenario: %(_PlaygroundSampleYaml.Identity)" />
    <RemoveDuplicates Inputs="@(_PlaygroundSampleName)">
      <Output TaskParameter="Filtered" ItemName="_PlaygroundUniqueSampleName" />
    </RemoveDuplicates>
    <Error Condition="'@(_PlaygroundUniqueSampleName->Count())' != '@(_PlaygroundSampleName->Count())'" Text="Two samples share a name. samples/ and samples/showcase/ are published into one folder, so their names must differ." />
    <Copy SourceFiles="@(PlaygroundOutputs);@(_PlaygroundSampleYaml);@(PlaygroundCast)" DestinationFolder="$(PublishDir)wwwroot/samples" />
    <PropertyGroup>
      <_PlaygroundIndexScenarios>@(_PlaygroundSampleName->'&quot;%(Identity)&quot;', ',')</_PlaygroundIndexScenarios>
      <_PlaygroundIndexCasts>@(PlaygroundCast->'&quot;%(Filename)&quot;', ',')</_PlaygroundIndexCasts>
    </PropertyGroup>
    <WriteLinesToFile
      File="$(PublishDir)wwwroot/samples/index.json"
      Lines="{&quot;scenarios&quot;:[$(_PlaygroundIndexScenarios)],&quot;casts&quot;:[$(_PlaygroundIndexCasts)]}"
      Overwrite="true" />
  </Target>

  <!--
    Static-host fallback: copy the fingerprinted dotnet entry JS to _framework/dotnet.js so that the import in
    worker.js resolves without an import map.
  -->
  <Target Name="_CopyDotnetJsFallback" AfterTargets="Publish" Condition="'$(PlaygroundSoftFingerprint)' == 'true'">
    <ItemGroup>
      <_DotnetEntryJs Include="$(PublishDir)wwwroot/_framework/dotnet.*.js"
                      Exclude="$(PublishDir)wwwroot/_framework/dotnet.native.*.js;$(PublishDir)wwwroot/_framework/dotnet.runtime.*.js" />
    </ItemGroup>
    <Copy SourceFiles="@(_DotnetEntryJs)" DestinationFiles="$(PublishDir)wwwroot/_framework/dotnet.js" />
  </Target>

</Project>
